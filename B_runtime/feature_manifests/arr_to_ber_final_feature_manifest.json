{
  "model": "RandomForestRegressor",
  "target": "log1p(arr_to_ber_min)",
  "prediction_output": "expm1(model prediction), minutes",
  "numeric_features": [
    "lon",
    "lat",
    "sog_knots",
    "cog_deg",
    "heading_deg",
    "distance_to_arrival_gate_km",
    "distance_to_main_berth_zone_km",
    "distance_to_west_berth_zone_km",
    "bearing_to_arrival_gate_deg",
    "heading_gate_difference_deg",
    "history_point_count_10min",
    "sog_mean_10min",
    "sog_min_10min",
    "sog_max_10min",
    "sog_change_10min",
    "history_point_count_20min",
    "sog_mean_20min",
    "sog_min_20min",
    "sog_max_20min",
    "sog_change_20min",
    "history_point_count_30min",
    "sog_mean_30min",
    "sog_min_30min",
    "sog_max_30min",
    "sog_change_30min",
    "sog_std_30min",
    "sog_acceleration_trend_30min",
    "cog_change_30min_deg",
    "cog_stability_30min",
    "heading_stability_30min",
    "trajectory_displacement_30min_km",
    "trajectory_distance_30min_km"
  ],
  "categorical_features": [
    "nav_status"
  ],
  "excluded_port_status_features": [
    "active_vessel_count",
    "approach_vessel_count",
    "approach_mean_sog",
    "approach_median_sog",
    "anchorage_present_count",
    "anchorage_confirmed_waiting_count",
    "berth_main_present_count",
    "berth_west_present_count",
    "berth_main_confirmed_occupied_count",
    "berth_west_confirmed_occupied_count",
    "berth_total_confirmed_occupied_count",
    "observed_inbound_gate_crossings_30m",
    "observed_inbound_gate_crossings_60m",
    "observed_inbound_gate_crossings_120m",
    "observed_outbound_gate_crossings_30m",
    "observed_outbound_gate_crossings_60m",
    "observed_outbound_gate_crossings_120m",
    "unique_inbound_vessels_60m",
    "unique_outbound_vessels_60m"
  ],
  "hyperparameters": {
    "n_estimators": 500,
    "max_depth": 6,
    "min_samples_leaf": 2,
    "max_features": 0.7,
    "random_state": 202401
  },
  "selection_rule": "Selected by lower validation MAE in Port Status ablation: AIS+Geo+Dynamic only vs AIS+Geo+Dynamic+Port Status."
}